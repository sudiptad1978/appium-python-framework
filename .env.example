# ---------------------------------------------------------------------------
# Optional environment overrides for the mobile test framework.
# Copy to `.env` and adjust - every variable here is optional, the YAML files
# under config/ contain the defaults. Values set here WIN over the YAML
# defaults, which lets CI inject per-job values without touching config files.
# ---------------------------------------------------------------------------

# Target platform: android | ios
# (CLI flag --platform always wins over this variable)
APP_PLATFORM=android

# Appium server management ------------------------------------------------
# Let the framework start/stop the Appium server automatically (true),
# or attach to an externally managed server (false, same as external: true)?
APP_EXTERNAL=false

# Host/port/binary overrides (defaults come from config/settings.yaml)
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
# Absolute path to the appium binary. Leave empty to search $PATH.
# Windows example: C:\Users\me\AppData\Roaming\npm\appium.cmd
APPIUM_BINARY=

# Device under test --------------------------------------------------------
# Override the values from config/<platform>.yaml, e.g. in CI where a
# specific emulator/simulator instance is provisioned per job.
APP_DEVICE_NAME=
APP_UDID=

# Application under test ----------------------------------------------------
# Absolute path to the app under test (apk / .app / .app.zip / .ipa).
# Overrides `app_path` from config/<platform>.yaml. Leave empty to keep the
# configured path.
APP_PATH=

# Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
